PORT=3777
HOST=0.0.0.0

# Optional server-side MCP endpoint for normal ChatGPT Developer Mode.
# Exposed at /mcp on the same host, for example https://art.darthspader.com/mcp.
# Leave token blank only on a trusted/private tunnel.
RABBIT_HOLE_MCP_BASE_URL=http://127.0.0.1:3777
RABBIT_HOLE_MCP_TOKEN=
RABBIT_HOLE_MCP_TIMEOUT_MS=120000

# Local LLM mode: install Ollama and run `ollama pull llama3.1:8b` or another model.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# Optional stronger local backend: LM Studio or llama.cpp OpenAI-compatible server.
# LM Studio default server URL is usually http://127.0.0.1:1234/v1.
# LLM_API_KEY can stay blank for local LM Studio/llama.cpp unless you configured one.
# LLM_PROVIDER=openai-compatible
LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_MODEL=qwen3-32b
LLM_API_KEY=
# Optional: local reasoning models can need a little longer to emit JSON plans.
LLM_PLANNING_TIMEOUT_MS=60000

# Optional Synapse/OpenAI second brain. The key is read only by the Node server.
# AI_MODE can be local, synapse, or auto. AUTO routes local -> Luna -> Terra -> Sol by cost/complexity.
AI_MODE=auto
AI_LOCAL_TIMEOUT_MS=45000
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_TIER=luna
OPENAI_MODEL=gpt-5.6-luna
OPENAI_MAX_OUTPUT_TOKENS=1200
OPENAI_REASONING_EFFORT=
OPENAI_REASONING_MODE=
OPENAI_TIMEOUT_MS=60000
OPENAI_HEALTH_TIMEOUT_MS=6000
OPENAI_RETRY_COUNT=1
OPENAI_RETRY_DELAY_MS=750
OPENAI_MAX_TOOL_ROUNDS=6
OPENAI_MAX_ESCALATION_ATTEMPTS=3
OPENAI_MAX_COST_PER_REQUEST=
OPENAI_DAILY_BUDGET=
OPENAI_MONTHLY_BUDGET=
OPENAI_LUNA_MODEL=gpt-5.6-luna
OPENAI_LUNA_MAX_OUTPUT_TOKENS=1200
OPENAI_LUNA_DAILY_BUDGET=
OPENAI_LUNA_MONTHLY_BUDGET=
OPENAI_TERRA_MODEL=gpt-5.6-terra
OPENAI_TERRA_MAX_OUTPUT_TOKENS=1200
OPENAI_TERRA_DAILY_BUDGET=
OPENAI_TERRA_MONTHLY_BUDGET=
OPENAI_SOL_MODEL=gpt-5.6-sol
OPENAI_SOL_MAX_OUTPUT_TOKENS=1600
OPENAI_SOL_DAILY_BUDGET=
OPENAI_SOL_MONTHLY_BUDGET=
# Optional custom cost estimates. Leave blank/0 to log tokens without dollar estimates.
OPENAI_INPUT_COST_PER_1M=
OPENAI_CACHED_INPUT_COST_PER_1M=
OPENAI_OUTPUT_COST_PER_1M=
OPENAI_LUNA_INPUT_COST_PER_1M=
OPENAI_LUNA_CACHED_INPUT_COST_PER_1M=
OPENAI_LUNA_OUTPUT_COST_PER_1M=
OPENAI_TERRA_INPUT_COST_PER_1M=
OPENAI_TERRA_CACHED_INPUT_COST_PER_1M=
OPENAI_TERRA_OUTPUT_COST_PER_1M=
OPENAI_SOL_INPUT_COST_PER_1M=
OPENAI_SOL_CACHED_INPUT_COST_PER_1M=
OPENAI_SOL_OUTPUT_COST_PER_1M=
OPENAI_USAGE_FILE=

# Optional hosted fallback compatible with OpenAI-style chat completions.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Prefer qobuz, tidal, library, or streaming in AI prompt wording.
STREAMING_SERVICE=qobuz

# Optional but recommended: verify generated tracks against TIDAL before showing them.
TIDAL_VERIFY=true
TIDAL_COUNTRY_CODE=US
TIDAL_CLIENT_ID=
TIDAL_CLIENT_SECRET=
TIDAL_ACCESS_TOKEN=
TIDAL_FETCH_TIMEOUT_MS=12000
TIDAL_QUALITY_LOOKUP_TIMEOUT_MS=15000
TIDAL_CIRCUIT_FAILURES=3
TIDAL_CIRCUIT_COOLDOWN_MS=45000

# Optional TIDAL profile mixes page.
# This needs a user-profile bearer token; catalog/client-credentials tokens cannot read personal mixes.
TIDAL_PROFILE_MIXES=true
TIDAL_PROFILE_CLIENT_ID=
TIDAL_PROFILE_CLIENT_SECRET=
TIDAL_PROFILE_REDIRECT_URI=
TIDAL_PROFILE_SCOPES=user.read playlists.read playlists.write recommendations.read collection.read collection.write search.read
TIDAL_PROFILE_ACCESS_TOKEN=
TIDAL_PROFILE_REFRESH_TOKEN=
TIDAL_PROFILE_TOKEN_FILE=
TIDAL_PROFILE_MIXES_ENDPOINT=
TIDAL_PROFILE_ARTIST_RADIO_FALLBACK=false
TIDAL_PINNED_MIXES_FILE=
TIDAL_PROFILE_CACHE_MS=300000

# Permanent exact-verification bridge for tracks that are TIDAL-verified but not
# immediately resolvable in Roon. Values are comma-separated per-attempt waits
# before each refreshed Roon playlist check. The default gives Roon about 10s
# before Rabbit Hole reports that a manual playlist refresh/retry is needed.
EXACT_ROON_BRIDGE_SYNC_DELAYS_MS=0,3000,7000
EXACT_ROON_BRIDGE_LOOKUP_TIMEOUT_MS=15000

# Radio station now-playing artwork.
# Uses the same resolver pattern as RoonPresence: TIDAL/web first, then Discogs/MusicBrainz,
# with optional Spotify artwork if you add Spotify developer credentials.
RADIO_METADATA_LOOKUP=true
RADIO_METADATA_CACHE_MAX=200
RADIO_METADATA_MIN_LOOKUP_INTERVAL_MS=1500
ROONPRESENCE_NOW_STATE_URL=http://127.0.0.1:8787/now-state
ROONPRESENCE_NOW_STATE_TIMEOUT_MS=1200
ART_BRIDGE_ENABLED=true
ART_BRIDGE_CACHE_URL=http://127.0.0.1:8787/api/art/cache
ART_BRIDGE_TIMEOUT_MS=1200
TIDAL_ARTWORK_LOOKUP=true
DISCOGS_LOOKUP=true
SPOTIFY_ARTWORK_LOOKUP=false
SPOTIFY_MARKET=US
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Async now-playing metadata enrichment.
# Uses Roon first, then high-confidence TIDAL matches, then MusicBrainz/Discogs fallbacks.
METADATA_ENRICHMENT=true
METADATA_ENRICHMENT_MIN_CONFIDENCE=80
METADATA_ENRICHMENT_TIMEOUT_MS=8000
METADATA_ENRICHMENT_CACHE_FILE=

# Rabbit Hole-owned music memory. This is separate from the disposable MusicBrainz index.
RABBIT_HOLE_MUSIC_MEMORY=true
RABBIT_HOLE_MUSIC_MEMORY_DB=

# Optional local MusicBrainz JSON-dump search index.
# Build it with: npm run import:musicbrainz -- C:\path\to\extracted\musicbrainz-json-dumps
# Public MusicBrainz remains the slow 1/sec fallback when the local index misses.
MUSICBRAINZ_LOCAL_INDEX=false
MUSICBRAINZ_INDEX_DIR=
MUSICBRAINZ_JSON_DUMP_DIR=
MUSICBRAINZ_PUBLIC_FALLBACK=true
MUSICBRAINZ_LOCAL_MAX_RESULTS=8

# Optional experimental Beatport metadata lookup.
# Beatport API access is partner/OAuth gated; keep disabled until an access token is available.
BEATPORT_ENABLED=false
BEATPORT_EXPERIMENTAL_PUBLIC_CLIENT=true
BEATPORT_CLIENT_ID=0GIvkCltVIuPkkwSJHp6NDb3s0potTjLBQr388Dd
BEATPORT_ACCESS_TOKEN=
BEATPORT_REFRESH_TOKEN=
BEATPORT_TOKEN_FILE=
BEATPORT_BASE_URL=https://api.beatport.com/v4
BEATPORT_TIMEOUT_MS=8000
BEATPORT_MAX_RESULTS=8
BEATPORT_REQUESTS_PER_SECOND=2
BEATPORT_CACHE_TTL_MS=86400000
BEATPORT_MAX_CACHE_ENTRIES=2000
BEATPORT_MAX_RETRIES=2
BEATPORT_MISSING_RETRY_MS=604800000
BEATPORT_MEMORY_BACKFILL=true
BEATPORT_MEMORY_BACKFILL_BATCH_SIZE=25
BEATPORT_MEMORY_BACKFILL_INTERVAL_MS=300000
BEATPORT_MEMORY_BACKFILL_DELAY_MS=2000
BEATPORT_MEMORY_BACKFILL_JITTER=0.2
BEATPORT_MEMORY_BACKFILL_START_DELAY_MS=30000

# Optional LAN PC monitor overlay shown only in Rabbit Hole full-window player mode.
PC_MONITOR_ENABLED=true
PC_MONITOR_BASE_URL=http://127.0.0.1:3088
PC_MONITOR_TIMEOUT_MS=1200

# Optional HQPlayer signal/rate display. The app also tries the standard HQPlayer 5 Desktop path if no command is set.
HQPLAYER_SIGNAL_PATH_PREFIX=poly-sinc-gauss-hires-mp, TPDF, PCM
HQPLAYER_SIGNAL_PATH_STATIC=
HQPLAYER_RATE_COMMAND="C:\Program Files\Signalyst\HQPlayer 5 Desktop\hqp5-control.exe" localhost --state
HQPLAYER_PTY_WORKER=
HQPLAYER_SIGNAL_PATH_POLL_MS=60000

# Rabbit Hole graph enrichment.
# MusicBrainz works without a key. Last.fm and Discogs are optional.
RABBIT_HOLE_MUSICBRAINZ=true
LASTFM_LOOKUP=true
LASTFM_API_KEY=
LASTFM_USERNAME=
LASTFM_HISTORY_LIMIT=200
LASTFM_TOP_ARTIST_LIMIT=50
LASTFM_TOP_ARTIST_PERIOD=12month
LASTFM_TIMEOUT_MS=3500
DISCOGS_TOKEN=
# Hard standby freshness (manual and automatic). No stale inventory refill.
STANDBY_COOLDOWN_REFRESHES=10
STANDBY_ACTIVITY_COOLDOWN_DAYS=30
STANDBY_SUGGESTED_COOLDOWN_DAYS=30
STANDBY_RAW_POOL_MULTIPLIER=4
STANDBY_SEARCH_BUDGET_MS=120000
