PORT=3777
HOST=0.0.0.0

# Independent Lyrion/LMS control. Set the address of your LMS HTTP server.
LYRION_URL=http://127.0.0.1:9000
LYRION_USERNAME=
LYRION_PASSWORD=

# Optional SiriusXM direct account features. Otherwise the native LMS plugin
# can still handle live channels. Credentials remain on your own server.
SIRIUSXM_USERNAME=
SIRIUSXM_PASSWORD=
SIRIUSXM_LYRION_PREFS=
# Address reachable by LMS for optional Rabbit Hole on-demand audio resources.
SIRIUSXM_PLAYBACK_BASE_URL=http://127.0.0.1:3777
FFMPEG_PATH=

# Optional server-side MCP endpoint for normal ChatGPT Developer Mode.
# Exposed at /mcp on the same host, for example https://your-host.example/mcp.
# Leave token blank only on a trusted/private tunnel.
RABBIT_HOLE_MCP_BASE_URL=http://127.0.0.1:3777
RABBIT_HOLE_MCP_TOKEN=
RABBIT_HOLE_MCP_TIMEOUT_MS=120000

# Local LLM mode: install Ollama and run `ollama pull llama3.1:8b` or another model.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# Optional stronger local backend: LM Studio or llama.cpp OpenAI-compatible server.
# LM Studio default server URL is usually http://127.0.0.1:1234/v1.
# LLM_API_KEY can stay blank for local LM Studio/llama.cpp unless you configured one.
# LLM_PROVIDER=openai-compatible
LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_MODEL=qwen3-32b
LLM_API_KEY=
# Optional: local reasoning models can need a little longer to emit JSON plans.
LLM_PLANNING_TIMEOUT_MS=60000

# Optional Synapse/OpenAI second brain. The key is read only by the Node server.
# AI_MODE can be local, synapse, or auto. AUTO routes local -> Luna -> Terra -> Sol by cost/complexity.
AI_MODE=auto
AI_LOCAL_TIMEOUT_MS=45000
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_TIER=luna
OPENAI_MODEL=gpt-5.6-luna
OPENAI_MAX_OUTPUT_TOKENS=1200
OPENAI_REASONING_EFFORT=
OPENAI_REASONING_MODE=
OPENAI_TIMEOUT_MS=60000
OPENAI_HEALTH_TIMEOUT_MS=6000
OPENAI_RETRY_COUNT=1
OPENAI_RETRY_DELAY_MS=750
OPENAI_MAX_TOOL_ROUNDS=6
OPENAI_MAX_ESCALATION_ATTEMPTS=3
OPENAI_MAX_COST_PER_REQUEST=
OPENAI_DAILY_BUDGET=
OPENAI_MONTHLY_BUDGET=
OPENAI_LUNA_MODEL=gpt-5.6-luna
OPENAI_LUNA_MAX_OUTPUT_TOKENS=1200
OPENAI_LUNA_DAILY_BUDGET=
OPENAI_LUNA_MONTHLY_BUDGET=
OPENAI_TERRA_MODEL=gpt-5.6-terra
OPENAI_TERRA_MAX_OUTPUT_TOKENS=1200
OPENAI_TERRA_DAILY_BUDGET=
OPENAI_TERRA_MONTHLY_BUDGET=
OPENAI_SOL_MODEL=gpt-5.6-sol
OPENAI_SOL_MAX_OUTPUT_TOKENS=1600
OPENAI_SOL_DAILY_BUDGET=
OPENAI_SOL_MONTHLY_BUDGET=
# Optional custom cost estimates. Leave blank/0 to log tokens without dollar estimates.
OPENAI_INPUT_COST_PER_1M=
OPENAI_CACHED_INPUT_COST_PER_1M=
OPENAI_OUTPUT_COST_PER_1M=
OPENAI_LUNA_INPUT_COST_PER_1M=
OPENAI_LUNA_CACHED_INPUT_COST_PER_1M=
OPENAI_LUNA_OUTPUT_COST_PER_1M=
OPENAI_TERRA_INPUT_COST_PER_1M=
OPENAI_TERRA_CACHED_INPUT_COST_PER_1M=
OPENAI_TERRA_OUTPUT_COST_PER_1M=
OPENAI_SOL_INPUT_COST_PER_1M=
OPENAI_SOL_CACHED_INPUT_COST_PER_1M=
OPENAI_SOL_OUTPUT_COST_PER_1M=
OPENAI_USAGE_FILE=

# Optional hosted fallback compatible with OpenAI-style chat completions.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Prefer qobuz, tidal, library, or streaming in AI prompt wording.
STREAMING_SERVICE=qobuz

# Optional but recommended: verify generated tracks against TIDAL before showing them.
TIDAL_VERIFY=true
TIDAL_COUNTRY_CODE=US
TIDAL_CLIENT_ID=
TIDAL_CLIENT_SECRET=
TIDAL_ACCESS_TOKEN=
TIDAL_FETCH_TIMEOUT_MS=12000
TIDAL_QUALITY_LOOKUP_TIMEOUT_MS=15000
TIDAL_CIRCUIT_FAILURES=3
TIDAL_CIRCUIT_COOLDOWN_MS=45000
TIDAL_IDENTITY_HIGH_CONFIDENCE=0.84
TIDAL_IDENTITY_CONFIDENCE_MARGIN=0.08
TIDAL_IDENTITY_ALTERNATE_VERSION_THRESHOLD=0.84
TIDAL_IDENTITY_LEGACY_ERA_GAP_YEARS=8
TIDAL_IDENTITY_LEGACY_ORIGINAL_YEAR_CUTOFF=2012
TIDAL_IDENTITY_LEGACY_PREFERENCE_MARGIN=0.05
# Durable cursor/page progress for standby catalog rotation. Runtime data is ignored by Git.
TIDAL_CATALOG_PAGINATION_FILE=./data/tidal-catalog-pagination.json
# Optional explicit legacy artist alias mappings; runtime JSON is ignored by Git.
TIDAL_ARTIST_ALIAS_FILE=./data/tidal-artist-aliases.json

# Optional TIDAL profile mixes page.
# This needs a user-profile bearer token; catalog/client-credentials tokens cannot read personal mixes.
TIDAL_PROFILE_MIXES=true
TIDAL_PROFILE_CLIENT_ID=
TIDAL_PROFILE_CLIENT_SECRET=
TIDAL_PROFILE_REDIRECT_URI=
TIDAL_PROFILE_SCOPES=user.read playlists.read playlists.write recommendations.read collection.read collection.write search.read
TIDAL_PROFILE_ACCESS_TOKEN=
TIDAL_PROFILE_REFRESH_TOKEN=
TIDAL_PROFILE_TOKEN_FILE=
TIDAL_PROFILE_MIXES_ENDPOINT=
TIDAL_PROFILE_ARTIST_RADIO_FALLBACK=false
TIDAL_PINNED_MIXES_FILE=
TIDAL_PROFILE_CACHE_MS=300000

# Permanent exact-verification bridge for tracks that are TIDAL-verified but not
# immediately resolvable in Roon. Values are comma-separated per-attempt waits
# before each refreshed Roon playlist check. The default gives Roon about 10s
# before Rabbit Hole reports that a manual playlist refresh/retry is needed.
EXACT_ROON_BRIDGE_SYNC_DELAYS_MS=0,3000,7000
EXACT_ROON_BRIDGE_LOOKUP_TIMEOUT_MS=15000

# Roon connection troubleshooting. Leave queue subscriptions enabled for normal use.
# Set ROON_QUEUE_SUBSCRIPTIONS_ENABLED=false for a controlled connection-stability test.
ROON_CONNECTION_DIAGNOSTICS=true
ROON_QUEUE_SUBSCRIPTIONS_ENABLED=true
# Avoid printing large queue/browse payloads from the Roon API library.
ROON_API_LOG_LEVEL=none
# Background Beatport work waits for this long after a Roon connection before starting.
ROON_BACKGROUND_WORK_GRACE_MS=120000

# Radio station now-playing artwork.
# Uses the same resolver pattern as RoonPresence: TIDAL/web first, then Discogs/MusicBrainz,
# with optional Spotify artwork if you add Spotify developer credentials.
RADIO_METADATA_LOOKUP=true
RADIO_METADATA_CACHE_MAX=200
RADIO_METADATA_MIN_LOOKUP_INTERVAL_MS=1500
ROONPRESENCE_NOW_STATE_URL=http://127.0.0.1:8787/now-state
ROONPRESENCE_NOW_STATE_TIMEOUT_MS=1200
ART_BRIDGE_ENABLED=true
ART_BRIDGE_CACHE_URL=http://127.0.0.1:8787/api/art/cache
ART_BRIDGE_TIMEOUT_MS=1200
TIDAL_ARTWORK_LOOKUP=true
DISCOGS_LOOKUP=true
SPOTIFY_ARTWORK_LOOKUP=false
SPOTIFY_MARKET=US
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Async now-playing metadata enrichment.
# Uses Roon first, then high-confidence TIDAL matches, then MusicBrainz/Discogs fallbacks.
METADATA_ENRICHMENT=true
METADATA_ENRICHMENT_MIN_CONFIDENCE=80
METADATA_ENRICHMENT_TIMEOUT_MS=8000
METADATA_ENRICHMENT_CACHE_FILE=

# Rabbit Hole-owned music memory. This is separate from the disposable MusicBrainz index.
RABBIT_HOLE_MUSIC_MEMORY=true
RABBIT_HOLE_MUSIC_MEMORY_DB=

# Local-library metadata pass. The CLI is read-only by default and never writes
# tags back to audio files. Use --write only after reviewing a limited report.
LOCAL_LIBRARY_ROOT=Z:\\Music
LOCAL_LIBRARY_FFPROBE_PATH=ffprobe
LOCAL_LIBRARY_REPORT_FILE=
LOCAL_LIBRARY_MIN_CONFIDENCE=85
LOCAL_METADATA_WRITEBACK=false

# Recommendation Engine v2 Phase 1 (opt-in; does not replace production discovery).
# The default spectral-baseline provider uses FFmpeg and remains the deterministic
# 80-D secondary feature set. The learned Discogs-EffNet provider is opt-in and
# runs in the isolated WSL worker below.
RABBIT_HOLE_RECOMMENDATION_V2_ENABLED=false
# Legacy v2 discovery integration for isolated callers: off, shadow, or rerank.
# The live server uses SONIC_PRODUCTION_MODE below for the production lane.
RABBIT_HOLE_RECOMMENDATION_V2_DISCOVERY_MODE=shadow
RABBIT_HOLE_RECOMMENDATION_V2_DISCOVERY_MODEL=discogs-effnet
RABBIT_HOLE_RECOMMENDATION_V2_DISCOVERY_MODEL_VERSION=1
RABBIT_HOLE_RECOMMENDATION_V2_DISCOVERY_RERANK_WEIGHT=0.18
RABBIT_HOLE_RECOMMENDATION_V2_DISCOVERY_MIN_COVERAGE=0.1
RABBIT_HOLE_RECOMMENDATION_V2_DISCOVERY_MIN_SCORED=5
# Sonic Review production lane: off, observe (diagnostics only), or blend.
# The Settings selector changes this at runtime; restart falls back to this value.
SONIC_PRODUCTION_MODE=off
# Fraction of the 0-100 score range available to Sonic (0.08 = at most 8 points).
SONIC_MAX_ADJUSTMENT=0.08
# Fingerprint coverage only: uses the exact TIDAL/Beatport Discogs-EffNet v1 path.
# Bulk work starts explicitly in Settings/API. Blend discovery can queue missing
# profiles. Limits/pause/progress are persisted; these seed a new installation.
RABBIT_HOLE_SONIC_LAZY_FILL_ENABLED=true
RABBIT_HOLE_SONIC_COVERAGE_CONCURRENCY=1
RABBIT_HOLE_SONIC_COVERAGE_BATCH_SIZE=5
RABBIT_HOLE_SONIC_COVERAGE_INTERVAL_MS=2000
RABBIT_HOLE_SONIC_COVERAGE_BATCH_PAUSE_MS=5000
# Shadow Sonic Neighbor genre-lane adjustments. Sparse/asymmetric evidence uses
# weak-conflict or uncertain instead of the strong conflicting penalty. Genre-risk
# rows receive no positive duration bonus by default.
RABBIT_HOLE_SONIC_GENRE_ADJUSTMENT_EXACT=0.05
RABBIT_HOLE_SONIC_GENRE_ADJUSTMENT_COMPATIBLE=0.06
RABBIT_HOLE_SONIC_GENRE_ADJUSTMENT_ADJACENT=0.01
RABBIT_HOLE_SONIC_GENRE_ADJUSTMENT_UNCERTAIN=-0.08
RABBIT_HOLE_SONIC_GENRE_ADJUSTMENT_WEAK_CONFLICT=-0.10
RABBIT_HOLE_SONIC_GENRE_ADJUSTMENT_CONFLICTING=-0.18
RABBIT_HOLE_SONIC_GENRE_ADJUSTMENT_INCOMPATIBLE=-0.24
# Positive genre bonuses are multiplied by the weaker side's evidence level.
# Scene evidence is a separate bounded softener and never proves exact genre.
RABBIT_HOLE_SONIC_GENRE_BONUS_SCALE_STRONG=1
RABBIT_HOLE_SONIC_GENRE_BONUS_SCALE_MEDIUM=0.6
RABBIT_HOLE_SONIC_GENRE_BONUS_SCALE_WEAK=0.25
RABBIT_HOLE_SONIC_GENRE_BONUS_SCENE_WEIGHT=0.15
RABBIT_HOLE_SONIC_MAX_ARRANGEMENT_BONUS_GENRE_RISK=0
RABBIT_HOLE_RECOMMENDATION_V2_DB=
RABBIT_HOLE_SONIC_EMBEDDING_PROVIDER=spectral-baseline
FFMPEG_PATH=
# For an external JSON worker, use || between arguments and {{file}}/{{model}}
# placeholders, for example: --file||{{file}}||--model||{{model}}
RABBIT_HOLE_SONIC_EMBEDDING_COMMAND=
RABBIT_HOLE_SONIC_EMBEDDING_ARGS=
RABBIT_HOLE_SONIC_EMBEDDING_MODEL=
RABBIT_HOLE_SONIC_EMBEDDING_MODEL_VERSION=1
RABBIT_HOLE_SONIC_EMBEDDING_TIMEOUT_MS=900000
RABBIT_HOLE_LIVE_SONIC_ANALYSIS_ENABLED=false
RABBIT_HOLE_LIVE_SONIC_ANALYSIS_AUTO_ANALYZE=false
RABBIT_HOLE_LIVE_SONIC_ANALYSIS_MAX_CONCURRENT=1
# Learned Essentia provider (kept outside the Windows/Roon runtime).
# Set RABBIT_HOLE_SONIC_EMBEDDING_PROVIDER=discogs-effnet to enable it.
# With the default wsl.exe command and empty args, the checked-in WSL wrapper
# uses ~/rabbit-hole-sonic-venv and the track model under ~/rabbit-hole-sonic-models.
# For the verified RTX 5090 GPU environment, set this to:
# /home/your-user/micromamba-root/envs/rabbit-hole-effnet-gpu
RABBIT_HOLE_SONIC_ESSENTIA_VENV=
RABBIT_HOLE_SONIC_ESSENTIA_COMMAND=wsl.exe
RABBIT_HOLE_SONIC_ESSENTIA_ARGS=
RABBIT_HOLE_SONIC_ESSENTIA_WORKER=
RABBIT_HOLE_SONIC_ESSENTIA_WSL_WRAPPER=
RABBIT_HOLE_SONIC_ESSENTIA_BATCH_WSL_WRAPPER=
RABBIT_HOLE_SONIC_ESSENTIA_MODEL_PATH=
RABBIT_HOLE_SONIC_ESSENTIA_MODEL_NAME=discogs_track_embeddings-effnet-bs64-1
RABBIT_HOLE_SONIC_ESSENTIA_MODEL_VERSION=1
RABBIT_HOLE_SONIC_ESSENTIA_OUTPUT=PartitionedCall:1
RABBIT_HOLE_SONIC_ESSENTIA_DIMENSIONS=1280
RABBIT_HOLE_SONIC_ESSENTIA_SAMPLE_RATE=16000
RABBIT_HOLE_SONIC_ESSENTIA_TIMEOUT_MS=900000
# CPU is the safe default. Set cuda when the WSL CUDA/cuDNN environment is installed.
RABBIT_HOLE_SONIC_ESSENTIA_DEVICE=cpu

# Optional local MusicBrainz JSON-dump search index.
# Build it with: npm run import:musicbrainz -- C:\path\to\extracted\musicbrainz-json-dumps
# Public MusicBrainz remains the slow 1/sec fallback when the local index misses.
MUSICBRAINZ_LOCAL_INDEX=false
MUSICBRAINZ_INDEX_DIR=
MUSICBRAINZ_JSON_DUMP_DIR=
MUSICBRAINZ_PUBLIC_FALLBACK=true
MUSICBRAINZ_LOCAL_MAX_RESULTS=8

# Optional experimental Beatport metadata lookup.
# Beatport API access is partner/OAuth gated; keep disabled until an access token is available.
BEATPORT_ENABLED=false
BEATPORT_EXPERIMENTAL_PUBLIC_CLIENT=true
BEATPORT_CLIENT_ID=0GIvkCltVIuPkkwSJHp6NDb3s0potTjLBQr388Dd
BEATPORT_ACCESS_TOKEN=
BEATPORT_REFRESH_TOKEN=
BEATPORT_TOKEN_FILE=
BEATPORT_BASE_URL=https://api.beatport.com/v4
BEATPORT_TIMEOUT_MS=8000
BEATPORT_MAX_RESULTS=8
BEATPORT_MAX_PREVIEW_BYTES=33554432
BEATPORT_REQUESTS_PER_SECOND=2
BEATPORT_CACHE_TTL_MS=86400000
BEATPORT_MAX_CACHE_ENTRIES=2000
BEATPORT_MAX_RETRIES=2
BEATPORT_MISSING_RETRY_MS=604800000
# Keep automated backfill off during normal playback; run the manual
# scripts/beatport-enrichment-backfill.js command for deliberate bulk work.
BEATPORT_MEMORY_BACKFILL=false
BEATPORT_MEMORY_BACKFILL_BATCH_SIZE=1
BEATPORT_MEMORY_BACKFILL_INTERVAL_MS=900000
BEATPORT_MEMORY_BACKFILL_DELAY_MS=5000
BEATPORT_MEMORY_BACKFILL_JITTER=0.2
BEATPORT_MEMORY_BACKFILL_START_DELAY_MS=30000

# Optional LAN PC monitor overlay shown only in Rabbit Hole full-window player mode.
PC_MONITOR_ENABLED=true
PC_MONITOR_BASE_URL=http://127.0.0.1:3088
PC_MONITOR_TIMEOUT_MS=1200

# Optional HQPlayer signal/rate display. The app also tries the standard HQPlayer 5 Desktop path if no command is set.
HQPLAYER_SIGNAL_PATH_PREFIX=
HQPLAYER_SIGNAL_PATH_STATIC=
HQPLAYER_RATE_COMMAND=
# Windows example (optional):
# HQPLAYER_RATE_COMMAND="C:\Program Files\Signalyst\HQPlayer 5 Desktop\hqp5-control.exe" localhost --state
HQPLAYER_PTY_WORKER=
HQPLAYER_SIGNAL_PATH_POLL_MS=60000

# Rabbit Hole graph enrichment.
# MusicBrainz works without a key. Last.fm and Discogs are optional.
RABBIT_HOLE_MUSICBRAINZ=true
LASTFM_LOOKUP=true
LASTFM_API_KEY=
LASTFM_USERNAME=
LASTFM_HISTORY_LIMIT=200
LASTFM_TOP_ARTIST_LIMIT=50
LASTFM_TOP_ARTIST_PERIOD=12month
LASTFM_TIMEOUT_MS=3500
DISCOGS_TOKEN=
# Optional OAuth 1.0a setup. Register the callback URL in Discogs Developers.
DISCOGS_CONSUMER_KEY=
DISCOGS_CONSUMER_SECRET=
DISCOGS_REDIRECT_URI=http://127.0.0.1:3777/api/discogs/oauth/callback
DISCOGS_OAUTH_TOKEN_FILE=./data/discogs-oauth-token.json
DISCOGS_BASE_URL=https://api.discogs.com
DISCOGS_TIMEOUT_MS=8000
DISCOGS_MAX_RESULTS=5
DISCOGS_MAX_RELEASE_LOOKUPS=5
DISCOGS_MIN_INTERVAL_MS=1000
DISCOGS_CACHE_TTL_MS=2592000000
DISCOGS_CACHE_FILE=./data/discogs-metadata-cache.json
DISCOGS_USER_AGENT=RabbitHole/0.1.0 (local metadata enrichment)
# Hard standby freshness (manual and automatic). No stale inventory refill.
STANDBY_COOLDOWN_REFRESHES=10
STANDBY_ACTIVITY_COOLDOWN_DAYS=30
STANDBY_SUGGESTED_COOLDOWN_DAYS=30
STANDBY_RAW_POOL_MULTIPLIER=4
STANDBY_SEARCH_BUDGET_MS=120000

# Separate SoundCloud account connection for playlist management only.
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
SOUNDCLOUD_REDIRECT_URI=http://127.0.0.1:3777/api/soundcloud/callback
